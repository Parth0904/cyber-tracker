{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "tsx scripts/migrate.ts",
    "reset": "tsx lib/database/reset.ts",
    "seed": "tsx lib/database/seed.ts",
    "backup": "tsx lib/database/backup.ts",
    "postgres-init": "tsx scripts/postgres-init.ts",
    "agent:dev": "tsx agent/src/index.ts",
    "agent:status": "tsx agent/src/cli.ts status",
    "agent:start": "powershell -ExecutionPolicy Bypass -File agent/scripts/start-agent.ps1",
    "agent:stop": "powershell -ExecutionPolicy Bypass -File agent/scripts/stop-agent.ps1",
    "agent:check": "powershell -ExecutionPolicy Bypass -File agent/scripts/check-agent.ps1",
    "agent:install": "powershell -ExecutionPolicy Bypass -File agent/scripts/install-task.ps1",
    "agent:uninstall": "powershell -ExecutionPolicy Bypass -File agent/scripts/uninstall-task.ps1",
    "agent:test": "tsx --test agent/tests/**/*.test.ts",
    "test:calendar": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.9",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-calendar-heatmap": "^1.10.0",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
