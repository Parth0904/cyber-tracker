# ==============================================================================
# Cyber Tracker — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your specific credentials.
# Do NOT commit actual secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# 32+ character random secret used for session cookie signing & token hashing.
AUTH_SECRET=your_32_character_random_hex_secret

# Administrator password for signing into Cyber Tracker web interface.
AUTH_PASSWORD=your_admin_login_password

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required in production)
# ------------------------------------------------------------------------------
# PostgreSQL / Neon pooled connection string.
DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# Optional fallback path for local development SQLite database (if DATABASE_URL is not set)
# SQLITE_DB_PATH=tracker.db

# ------------------------------------------------------------------------------
# 3. MACHINE-TO-MACHINE AGENT SYNCHRONIZATION (Required for Windows Agent)
# ------------------------------------------------------------------------------
# Dedicated 64-character bearer token for Windows Agent -> /api/agent/sync
AGENT_SYNC_TOKEN=your_64_character_hex_agent_sync_token

# ------------------------------------------------------------------------------
# 4. WINDOWS WORK TIME AGENT RUNTIME CONFIGURATION (Agent environment)
# ------------------------------------------------------------------------------
# Target URL where the Windows Agent pushes tracked work sessions.
CYBER_TRACKER_API_URL=https://your-production-app.vercel.app

# Inactivity threshold in minutes before pausing active work tracking (default: 5)
CYBER_AGENT_IDLE_MINUTES=5

# Synchronization polling interval in seconds (default: 15)
CYBER_AGENT_SYNC_INTERVAL_SECONDS=15

# Set to 1 for verbose agent diagnostic logging (default: 0)
CYBER_AGENT_DEBUG=0

# ------------------------------------------------------------------------------
# 5. SCHEDULED CRON MAINTENANCE (Optional)
# ------------------------------------------------------------------------------
# Secret token for authenticating Vercel cron endpoints (/api/settings/backup)
# CRON_SECRET=your_cron_secret
